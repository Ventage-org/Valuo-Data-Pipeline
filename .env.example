# =============================================================================
# CONFIGURACIÓN DE CONEXIÓN A BASE DE DATOS DE ENTRENAMIENTO (POSTGRESQL)
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=inmobiliaria_ml_db
DB_USER=postgres
DB_PASSWORD=5432
DB_SCHEMA=public
# SSL para PostgreSQL (en local 'prefer' o 'disable'; en Azure Flexible Server obligatorio 'require')
DB_SSLMODE=prefer

# Pool de conexiones (opcional para concurrencia)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# =============================================================================
# PARTICIÓN TEMPORAL (TRAIN vs TEST)
# =============================================================================
# Todo registro con (anio * 4 + trimestre) <= (CORTE_TRAIN_ANIO * 4 + CORTE_TRAIN_TRIMESTRE) será TRAIN.
# Por defecto: 2023-4 (hasta 2023-Q4 es TRAIN; 2024 en adelante es TEST para la tesis).
CORTE_TRAIN_ANIO=2023
CORTE_TRAIN_TRIMESTRE=4
